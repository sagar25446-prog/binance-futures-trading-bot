# ─────────────────────────────────────────────────────────
# Binance Futures Testnet / Live — Trading Bot Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#
# Testnet API keys (safe testing): https://testnet.binancefuture.com
# Live API keys (real capital):    https://www.binance.com
# ─────────────────────────────────────────────────────────

# Binance Futures API Credentials
BINANCE_TESTNET_API_KEY=your_api_key_here
BINANCE_TESTNET_API_SECRET=your_api_secret_here

# API Base URL:
# For Testnet: https://testnet.binancefuture.com
# For Live:    https://fapi.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Network & Resilience
RECV_WINDOW=5000
MAX_RETRIES=3
RETRY_DELAY=1.0
REQUEST_TIMEOUT=30.0

# ─────────────────────────────────────────────────────────
# Algorithmic Trading Safeguards & Risk Controls
# ─────────────────────────────────────────────────────────
# Trading Mode: 'paper' (simulated fills/fees) or 'live' (real orders)
TRADING_MODE=paper

# Max risk percentage of total equity on any single trade (0.01 = 1%)
MAX_RISK_PER_TRADE_PCT=0.01

# Circuit Breakers: Daily loss limit (0.03 = 3%) and Max Drawdown (0.08 = 8%)
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.08

# Leverage & Margin (Strictly Isolated to protect balance; safe leverage cap)
MAX_LEVERAGE=3
MARGIN_TYPE=ISOLATED
